# Copy to .env.local. Never prefix secrets with NEXT_PUBLIC_.
#
# The Neon block is written for you: `neon deploy` (or `neon env pull`) pulls
# these from the linked branch into .env.local. Only the "App settings" at the
# bottom are yours to add.

# ---- Neon (managed by `neon env pull`) ----
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require   # pooled: the app
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require # direct: migrations
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.c-8.us-east-2.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://ep-xxx.neonauth.c-8.us-east-2.aws.neon.tech/neondb/auth/.well-known/jwks.json
NEON_REALTIME_URL=wss://...
NEON_REALTIME_SECRET=
# (also pulled, not used by the app yet: NEON_BRANCH*, NEON_FUNCTION_HOST_SUFFIX, AWS_* object storage, NEON_AI_GATEWAY_*)

# ---- App settings ----
# Signs Neon Auth session cookies. 32+ random characters, e.g. `openssl rand -base64 32`.
NEON_AUTH_COOKIE_SECRET=
# The browser's copy of the Realtime URL (Next.js expands $VAR in env files).
NEXT_PUBLIC_NEON_REALTIME_URL=$NEON_REALTIME_URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
# "Demo shortcuts" on /sign-in sign in as the seeded accounts. Set to off in production.
DEMO_LOGIN=on
# Password for the seeded demo accounts (npm run db:seed). Optional.
SEED_DEMO_PASSWORD=GuildFit-demo-2026

# ---- Later chapters (not wired yet) ----
# Paystack (test mode). Create a monthly NGN 5,000 plan and paste its code.
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PLAN_CODE=PLN_xxx
# Stream (chat + video share one app)
NEXT_PUBLIC_STREAM_API_KEY=
STREAM_API_SECRET=
# ImageKit
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=public_xxx
IMAGEKIT_PRIVATE_KEY=private_xxx
# Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
