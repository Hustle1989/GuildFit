# Copy to .env.local and fill in. Never prefix secrets with NEXT_PUBLIC_.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Neon Postgres (use a dev branch locally). Region: aws-eu-central-1
DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Neon Auth (Neon console -> Auth). Cookie secret must be 32+ characters.
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.eu-central-1.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=replace-with-a-random-string-at-least-32-chars

# Neon Realtime (beta). Only the URL is public.
NEON_REALTIME_SECRET=
NEON_REALTIME_DB=neondb
NEXT_PUBLIC_NEON_REALTIME_URL=

# Paystack (test mode). Create a monthly NGN 5,000 plan and paste its code.
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PLAN_CODE=PLN_xxx

# Stream (chat + video share one app)
NEXT_PUBLIC_STREAM_API_KEY=
STREAM_API_SECRET=

# ImageKit
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=public_xxx
IMAGEKIT_PRIVATE_KEY=private_xxx

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
